{"version":"0.3.0","body":"/**\n * Free Excel Data Profiler and Data Quality Analyzer\n *\n * SOURCE SAFETY:\n * The active source worksheet is read only. All source information is read\n * into memory. Write operations target only the three report worksheets.\n */\n\ntype CellValue = string | number | boolean;\ntype Severity = \"Info\" | \"Review\" | \"Concern\";\ntype QualityFlag = \"Good\" | \"Review\" | \"Concern\";\ntype IdentifierFlag = \"Yes\" | \"Possible\" | \"No\";\ntype TypeFamily = \"Boolean\" | \"Numeric\" | \"Date\" | \"Text\" | \"Error\";\n\ninterface Issue {\n  severity: Severity;\n  column: string;\n  issueType: string;\n  description: string;\n  affected: number;\n  percent: number;\n  recommendation: string;\n}\n\ninterface ClassifiedValue {\n  family: TypeFamily;\n  detail:\n  | \"Boolean\"\n  | \"Integer\"\n  | \"Decimal\"\n  | \"Date\"\n  | \"DateTime\"\n  | \"Text\"\n  | \"Error\";\n  numericValue?: number;\n  dateValue?: Date;\n}\n\ninterface IdentifierResult {\n  result: IdentifierFlag;\n  headerIndicator: boolean;\n  strongEvidence: boolean;\n}\n\ninterface PatternDefinition {\n  type: string;\n  sensitiveType: string;\n  headerPattern: RegExp;\n  test: (value: string) => boolean;\n  requireHeaderWithoutStrongEvidence?: boolean;\n}\n\ninterface PatternResult {\n  type: string;\n  sensitiveType: string;\n  matchCount: number;\n  exceptionCount: number;\n  conformance: number;\n  detected: boolean;\n}\n\ninterface SensitiveResult {\n  detected: boolean;\n  type: string;\n  count: number;\n}\n\ninterface ColumnResult {\n  row: CellValue[];\n  confidence: number;\n  qualityFlag: QualityFlag;\n  identifier: IdentifierFlag;\n  sensitive: boolean;\n  conversionRisk: boolean;\n}\n\ninterface ProfileResults {\n  columns: ColumnResult[];\n  issues: Issue[];\n  totalPopulated: number;\n  totalBlank: number;\n  emptyColumns: number;\n  concernColumns: number;\n  identifierColumns: number;\n  sensitiveColumns: number;\n  conversionRiskColumns: number;\n  consistencyScore: number;\n}\n\ninterface SourceSnapshot {\n  address: string;\n  rowCount: number;\n  columnCount: number;\n  values: CellValue[][];\n  formulas: CellValue[][];\n  numberFormats: string[][];\n}\n\nfunction main(workbook: ExcelScript.Workbook) {\n  const outputNames = [\n    \"Profile Summary\",\n    \"Column Profile\",\n    \"Data Quality Issues\"\n  ];\n\n  try {\n    /*\n     * SOURCE SAFETY BOUNDARY\n     *\n     * sourceWorksheet and sourceRange are used only with read methods.\n     * No write method in this script targets either object.\n     */\n    const sourceWorksheet = workbook.getActiveWorksheet();\n    const sourceName = sourceWorksheet.getName();\n\n    if (\n      outputNames.some(\n        (name: string): boolean =>\n          name.toLowerCase() === sourceName.toLowerCase()\n      )\n    ) {\n      throw new Error(\n        `The active worksheet \"${sourceName}\" is a profiling output sheet. ` +\n        \"Select the worksheet containing the source data and run the script again.\"\n      );\n    }\n\n    const sourceRange = sourceWorksheet.getUsedRange(true);\n\n    let sourceValues: CellValue[][] = [];\n    let sourceTexts: string[][] = [];\n    let sourceFormulas: CellValue[][] = [];\n    let sourceValueTypes: ExcelScript.RangeValueType[][] = [];\n    let sourceNumberFormats: string[][] = [];\n\n    let sourceAddress = \"N/A\";\n    let recordCount = 0;\n    let columnCount = 0;\n    let sourceSnapshot: SourceSnapshot | null = null;\n\n    /*\n     * Read the source range once into memory. No source range is written\n     * back after this point.\n     */\n    if (sourceRange) {\n      sourceValues = sourceRange.getValues();\n      sourceTexts = sourceRange.getTexts();\n      sourceFormulas = sourceRange.getFormulas();\n      sourceValueTypes = sourceRange.getValueTypes();\n      sourceNumberFormats = sourceRange.getNumberFormats();\n\n      sourceAddress = sourceRange.getAddress();\n      columnCount = sourceRange.getColumnCount();\n      recordCount = Math.max(0, sourceRange.getRowCount() - 1);\n\n      sourceSnapshot = {\n        address: sourceAddress,\n        rowCount: sourceRange.getRowCount(),\n        columnCount,\n        values: cloneCellMatrix(sourceValues),\n        formulas: cloneCellMatrix(sourceFormulas),\n        numberFormats: cloneStringMatrix(sourceNumberFormats)\n      };\n    }\n\n    const headers = buildDisplayHeaders(\n      sourceValues.length > 0 ? sourceValues[0] : [],\n      columnCount\n    );\n\n    const duplicateRecords = countDuplicateRows(sourceValues);\n    const duplicatePercent = safeDivide(\n      duplicateRecords,\n      recordCount\n    );\n\n    const profile = profileColumns(\n      sourceValues,\n      sourceTexts,\n      sourceValueTypes,\n      sourceNumberFormats,\n      headers,\n      recordCount,\n      columnCount\n    );\n\n    if (!sourceRange || columnCount === 0) {\n      profile.issues.push(\n        makeIssue(\n          \"Concern\",\n          \"Dataset\",\n          \"Empty Dataset\",\n          \"The selected worksheet does not contain a dataset to profile.\",\n          0,\n          0,\n          \"Place or import a dataset on this worksheet and run the profiler again.\"\n        )\n      );\n    } else if (recordCount === 0) {\n      profile.issues.push(\n        makeIssue(\n          \"Review\",\n          \"Dataset\",\n          \"Header-Only Dataset\",\n          \"The selected range contains headers but no data records.\",\n          0,\n          0,\n          \"Confirm that the expected data records were imported.\"\n        )\n      );\n    }\n\n    if (duplicateRecords > 0) {\n      profile.issues.push(\n        makeIssue(\n          duplicatePercent >= 0.20 ? \"Concern\" : \"Review\",\n          \"Dataset\",\n          \"Duplicate Records\",\n          `${formatInteger(duplicateRecords)} of ${formatInteger(recordCount)} ` +\n          \"records are exact duplicates beyond their first occurrence.\",\n          duplicateRecords,\n          duplicatePercent,\n          \"Review whether exact duplicate records are expected. No records were removed.\"\n        )\n      );\n    }\n\n    if (recordCount > 100000) {\n      profile.issues.push(\n        makeIssue(\n          \"Info\",\n          \"Dataset\",\n          \"Large Dataset\",\n          \"This dataset contains more than 100,000 records. The free Excel profiler \" +\n          \"is designed primarily for smaller datasets, and profiling may take longer.\",\n          recordCount,\n          1,\n          \"Allow additional processing time and review workbook performance.\"\n        )\n      );\n    }\n\n    const possibleCells = recordCount * columnCount;\n    const completeness = safeDivide(\n      profile.totalPopulated,\n      possibleCells\n    );\n\n    /*\n     * Only prior report worksheets may be deleted.\n     * The active source was already rejected if it has an output-sheet name.\n     */\n    refreshOutputSheets(workbook, outputNames);\n\n    /*\n     * These are the only worksheets that receive write operations.\n     */\n    const summarySheet = workbook.addWorksheet(\"Profile Summary\");\n    const columnProfileSheet = workbook.addWorksheet(\"Column Profile\");\n    const issuesSheet = workbook.addWorksheet(\"Data Quality Issues\");\n\n    writeSummarySheet(\n      summarySheet,\n      sourceName,\n      sourceAddress,\n      recordCount,\n      columnCount,\n      duplicateRecords,\n      duplicatePercent,\n      completeness,\n      profile\n    );\n\n    writeColumnProfileSheet(\n      columnProfileSheet,\n      profile.columns\n    );\n\n    writeIssueSheet(\n      issuesSheet,\n      profile.issues\n    );\n\n    /*\n     * Read-only regression check. It does not restore or rewrite anything.\n     */\n    verifySourceUnchanged(\n      sourceWorksheet,\n      sourceSnapshot\n    );\n\n    summarySheet.activate();\n  } catch (error) {\n    const message = error instanceof Error\n      ? error.message\n      : String(error);\n\n    throw new Error(\n      `Data profiling could not be completed. ${message}`\n    );\n  }\n}\n\nfunction profileColumns(\n  values: CellValue[][],\n  texts: string[][],\n  valueTypes: ExcelScript.RangeValueType[][],\n  numberFormats: string[][],\n  headers: string[],\n  recordCount: number,\n  columnCount: number\n): ProfileResults {\n  const results: ColumnResult[] = [];\n  const issues: Issue[] = [];\n\n  let totalPopulated = 0;\n  let totalBlank = 0;\n  let emptyColumns = 0;\n  let concernColumns = 0;\n  let identifierColumns = 0;\n  let sensitiveColumns = 0;\n  let conversionRiskColumns = 0;\n  let weightedConfidence = 0;\n  let confidenceWeight = 0;\n\n  for (let column = 0; column < columnCount; column++) {\n    const name = headers[column];\n\n    let populated = 0;\n    let blank = 0;\n    let errorCount = 0;\n    let booleanCount = 0;\n    let integerCount = 0;\n    let decimalCount = 0;\n    let dateCount = 0;\n    let dateTimeCount = 0;\n    let textCount = 0;\n\n    let leadingWhitespace = 0;\n    let trailingWhitespace = 0;\n    let whitespaceExceptionCount = 0;\n    let unusualCharacterCount = 0;\n    let ambiguousDateTextCount = 0;\n    let futureDateCount = 0;\n    let veryOldDateCount = 0;\n    let scientificNotationCount = 0;\n    let longNumericCount = 0;\n\n    const numericValues: number[] = [];\n    const dateValues: Date[] = [];\n    const textLengths: number[] = [];\n    const structuralLengths: number[] = [];\n    const patternValues: string[] = [];\n    const examples: string[] = [];\n\n    const distinct = new Set<string>();\n    const shapeCounts = new Map<string, number>();\n    const frequency = new Map<\n      string,\n      { value: string; count: number }\n    >();\n\n    for (let row = 1; row < values.length; row++) {\n      const value = values[row][column];\n      const text = safeStringValue(texts, row, column);\n      const valueType = safeTypeValue(valueTypes, row, column);\n      const numberFormat = safeStringValue(\n        numberFormats,\n        row,\n        column\n      );\n\n      /*\n       * Whitespace-only strings are missing, but remain unchanged in Excel.\n       * Zero and FALSE remain populated.\n       */\n      if (isBlank(value, valueType)) {\n        blank++;\n        continue;\n      }\n\n      populated++;\n\n      const display = safeDisplayValue(text, value);\n      patternValues.push(display.trim());\n\n      const classified = classifyValue(\n        value,\n        text,\n        valueType,\n        numberFormat\n      );\n\n      if (classified.family === \"Error\") {\n        errorCount++;\n      } else if (classified.family === \"Boolean\") {\n        booleanCount++;\n      } else if (classified.family === \"Numeric\") {\n        if (classified.detail === \"Integer\") {\n          integerCount++;\n        } else {\n          decimalCount++;\n        }\n\n        if (classified.numericValue !== undefined) {\n          numericValues.push(classified.numericValue);\n\n          const digitLength = getNumericDigitLength(\n            classified.numericValue,\n            display\n          );\n\n          if (digitLength > 0) {\n            structuralLengths.push(digitLength);\n          }\n\n          if (\n            Math.abs(classified.numericValue) >= 1e15 ||\n            digitLength > 15\n          ) {\n            longNumericCount++;\n          }\n        }\n      } else if (classified.family === \"Date\") {\n        if (classified.detail === \"DateTime\") {\n          dateTimeCount++;\n        } else {\n          dateCount++;\n        }\n\n        if (classified.dateValue) {\n          dateValues.push(classified.dateValue);\n\n          if (\n            classified.dateValue.getTime() >\n            new Date().getTime()\n          ) {\n            futureDateCount++;\n          }\n\n          if (classified.dateValue.getUTCFullYear() < 1900) {\n            veryOldDateCount++;\n          }\n        }\n      } else {\n        textCount++;\n      }\n\n      if (typeof value === \"string\") {\n        /*\n         * This is an in-memory comparison against the original string.\n         * No trimmed value is written to Excel.\n         */\n        const originalText = value;\n        const trimmedText = originalText.trim();\n\n        textLengths.push(trimmedText.length);\n        structuralLengths.push(trimmedText.length);\n\n        if (originalText !== trimmedText) {\n          whitespaceExceptionCount++;\n        }\n\n        if (/^\\s/.test(originalText)) {\n          leadingWhitespace++;\n        }\n\n        if (/\\s$/.test(originalText)) {\n          trailingWhitespace++;\n        }\n\n        if (containsUnusualCharacters(originalText)) {\n          unusualCharacterCount++;\n        }\n\n        if (\n          classified.family !== \"Date\" &&\n          resemblesAmbiguousShortDate(trimmedText)\n        ) {\n          ambiguousDateTextCount++;\n        }\n\n        const shape = valueShape(trimmedText);\n\n        shapeCounts.set(\n          shape,\n          (shapeCounts.get(shape) || 0) + 1\n        );\n      }\n\n      if (\n        typeof value === \"number\" &&\n        (\n          /[eE][+-]?\\d+/.test(text) ||\n          /[eE][+-]/.test(numberFormat)\n        )\n      ) {\n        scientificNotationCount++;\n      }\n\n      const canonical = canonicalValue(value, valueType);\n      distinct.add(canonical);\n\n      const previous = frequency.get(canonical);\n\n      if (previous) {\n        previous.count++;\n      } else {\n        frequency.set(canonical, {\n          value: display,\n          count: 1\n        });\n      }\n\n      if (\n        examples.length < 3 &&\n        display.length > 0 &&\n        examples.indexOf(display) < 0\n      ) {\n        examples.push(display);\n      }\n    }\n\n    totalPopulated += populated;\n    totalBlank += blank;\n\n    if (populated === 0) {\n      emptyColumns++;\n    }\n\n    const completeness = safeDivide(populated, recordCount);\n    const distinctCount = distinct.size;\n    const uniqueness = safeDivide(distinctCount, populated);\n    const duplicateValueCount = Math.max(\n      0,\n      populated - distinctCount\n    );\n\n    /*\n     * Integer and Decimal are combined as Numeric.\n     * Date and DateTime are combined as Date.\n     */\n    const familyCounts: {\n      name: TypeFamily;\n      count: number;\n    }[] = [\n        { name: \"Numeric\", count: integerCount + decimalCount },\n        { name: \"Date\", count: dateCount + dateTimeCount },\n        { name: \"Text\", count: textCount },\n        { name: \"Boolean\", count: booleanCount },\n        { name: \"Error\", count: errorCount }\n      ];\n\n    familyCounts.sort(\n      (\n        first: { name: TypeFamily; count: number },\n        second: { name: TypeFamily; count: number }\n      ): number => second.count - first.count\n    );\n\n    const observedFamilies = familyCounts.filter(\n      (\n        item: { name: TypeFamily; count: number }\n      ): boolean => item.count > 0\n    );\n\n    const dominant = observedFamilies.length > 0\n      ? observedFamilies[0]\n      : { name: \"Text\" as TypeFamily, count: 0 };\n\n    const confidence = safeDivide(\n      dominant.count,\n      populated\n    );\n\n    const mixedTypes = observedFamilies.length > 1;\n\n    const observedTypes = observedFamilies.length > 0\n      ? observedFamilies\n        .map(\n          (\n            item: { name: TypeFamily; count: number }\n          ): string =>\n            `${formatPercentText(\n              safeDivide(item.count, populated)\n            )} ${item.name}`\n        )\n        .join(\", \")\n      : \"N/A\";\n\n    let detectedType = \"Empty\";\n\n    if (populated > 0) {\n      if (dominant.name === \"Numeric\") {\n        detectedType = decimalCount > 0\n          ? \"Decimal\"\n          : \"Integer\";\n      } else if (dominant.name === \"Date\") {\n        detectedType = dateTimeCount > 0\n          ? \"DateTime\"\n          : \"Date\";\n      } else {\n        detectedType = dominant.name;\n      }\n    }\n\n    weightedConfidence += confidence * populated;\n    confidenceWeight += populated;\n\n    let minimum: CellValue = \"N/A\";\n    let maximum: CellValue = \"N/A\";\n\n    if (\n      dominant.name === \"Numeric\" &&\n      numericValues.length > 0\n    ) {\n      const bounds = getNumberBounds(numericValues);\n      minimum = bounds.minimum;\n      maximum = bounds.maximum;\n    } else if (\n      dominant.name === \"Date\" &&\n      dateValues.length > 0\n    ) {\n      const bounds = getDateBounds(dateValues);\n      minimum = formatDate(bounds.minimum);\n      maximum = formatDate(bounds.maximum);\n    }\n\n    const lengthSummary = summarizeLengths(textLengths);\n\n    let commonValue = \"N/A\";\n    let commonCount = 0;\n\n    frequency.forEach(\n      (item: { value: string; count: number }): void => {\n        if (item.count > commonCount) {\n          commonValue = item.value;\n          commonCount = item.count;\n        }\n      }\n    );\n\n    const commonPercent = safeDivide(\n      commonCount,\n      populated\n    );\n\n    const structureStability = calculateStructureStability(\n      shapeCounts,\n      structuralLengths,\n      populated\n    );\n\n    const identifier = detectIdentifier(\n      name,\n      completeness,\n      uniqueness,\n      structureStability,\n      populated,\n      integerCount,\n      decimalCount,\n      textCount,\n      patternValues\n    );\n\n    if (identifier.result !== \"No\") {\n      identifierColumns++;\n    }\n\n    const pattern = detectDominantPattern(\n      name,\n      patternValues\n    );\n\n    const sensitive = detectSensitiveData(\n      patternValues,\n      pattern\n    );\n\n    if (sensitive.detected) {\n      sensitiveColumns++;\n    }\n\n    const columnIssues: Issue[] = [];\n    const notes: string[] = [];\n\n    addHeaderIssues(name, column, columnIssues, notes);\n\n    if (recordCount > 0 && populated === 0) {\n      columnIssues.push(\n        makeIssue(\n          \"Concern\",\n          name,\n          \"Empty Column\",\n          `${name} is completely empty across ` +\n          `${formatInteger(recordCount)} records.`,\n          recordCount,\n          1,\n          \"Confirm whether this column is required or was imported as expected.\"\n        )\n      );\n\n      notes.push(\"Column is completely empty.\");\n    } else if (blank > 0) {\n      const missingPercent = safeDivide(blank, recordCount);\n\n      const severity: Severity =\n        completeness < 0.20\n          ? \"Concern\"\n          : missingPercent >= 0.01\n            ? \"Review\"\n            : \"Info\";\n\n      columnIssues.push(\n        makeIssue(\n          severity,\n          name,\n          \"Missing Values\",\n          `${formatInteger(blank)} of ${formatInteger(recordCount)} records ` +\n          `are blank or whitespace-only in ${name}.`,\n          blank,\n          missingPercent,\n          \"Review whether blank or whitespace-only values are expected.\"\n        )\n      );\n\n      notes.push(\n        `${formatInteger(blank)} blank or whitespace-only values.`\n      );\n    }\n\n    if (mixedTypes) {\n      const minorityCount = populated - dominant.count;\n      const minorityPercent = safeDivide(\n        minorityCount,\n        populated\n      );\n\n      columnIssues.push(\n        makeIssue(\n          minorityPercent >= 0.20 ? \"Concern\" : \"Review\",\n          name,\n          \"Mixed Data Types\",\n          `${formatInteger(minorityCount)} of ${formatInteger(populated)} ` +\n          `populated ${name} values differ from the dominant type. ` +\n          `Observed types: ${observedTypes}.`,\n          minorityCount,\n          minorityPercent,\n          \"Review whether the minority data types are expected.\"\n        )\n      );\n\n      notes.push(`Observed types: ${observedTypes}.`);\n    }\n\n    if (errorCount > 0) {\n      columnIssues.push(\n        makeIssue(\n          safeDivide(errorCount, populated) >= 0.10\n            ? \"Concern\"\n            : \"Review\",\n          name,\n          \"Excel Error Values\",\n          `${formatInteger(errorCount)} of ${formatInteger(populated)} ` +\n          `populated ${name} values are Excel errors.`,\n          errorCount,\n          safeDivide(errorCount, populated),\n          \"Review the source formulas or imported error values.\"\n        )\n      );\n\n      notes.push(\n        `${formatInteger(errorCount)} Excel error values.`\n      );\n    }\n\n    if (whitespaceExceptionCount > 0) {\n      const whitespacePercent = safeDivide(\n        whitespaceExceptionCount,\n        textLengths.length\n      );\n\n      columnIssues.push(\n        makeIssue(\n          \"Review\",\n          name,\n          \"Whitespace\",\n          `${name} contains ${formatInteger(whitespaceExceptionCount)} of ` +\n          `${formatInteger(textLengths.length)} populated text values with ` +\n          \"leading or trailing whitespace.\",\n          whitespaceExceptionCount,\n          whitespacePercent,\n          \"Review whether leading or trailing whitespace is expected.\"\n        )\n      );\n\n      notes.push(\n        `${formatInteger(whitespaceExceptionCount)} whitespace exceptions ` +\n        `(${formatInteger(leadingWhitespace)} leading; ` +\n        `${formatInteger(trailingWhitespace)} trailing).`\n      );\n    }\n\n    if (unusualCharacterCount > 0) {\n      columnIssues.push(\n        makeIssue(\n          \"Review\",\n          name,\n          \"Non-standard Characters\",\n          `${formatInteger(unusualCharacterCount)} of ` +\n          `${formatInteger(textLengths.length)} populated text values in ` +\n          `${name} contain control or replacement characters.`,\n          unusualCharacterCount,\n          safeDivide(unusualCharacterCount, textLengths.length),\n          \"Review affected text for import or encoding artifacts.\"\n        )\n      );\n\n      notes.push(\n        `${formatInteger(unusualCharacterCount)} unusual-character values.`\n      );\n    }\n\n    const lengthAnomalies = countLengthAnomalies(textLengths);\n\n    if (lengthAnomalies > 0) {\n      columnIssues.push(\n        makeIssue(\n          \"Review\",\n          name,\n          \"Text Length Variation\",\n          `${formatInteger(lengthAnomalies)} of ` +\n          `${formatInteger(textLengths.length)} populated text values in ` +\n          `${name} have potentially unusual lengths.`,\n          lengthAnomalies,\n          safeDivide(lengthAnomalies, textLengths.length),\n          \"Review unusual lengths as potential anomalies; they are not necessarily invalid.\"\n        )\n      );\n\n      notes.push(\"Potential text-length anomalies detected.\");\n    }\n\n    if (\n      dominant.name === \"Date\" &&\n      futureDateCount > 0\n    ) {\n      columnIssues.push(\n        makeIssue(\n          \"Review\",\n          name,\n          \"Future Dates\",\n          `${formatInteger(futureDateCount)} of ` +\n          `${formatInteger(dateValues.length)} applicable date values in ` +\n          `${name} are later than the profiling date.`,\n          futureDateCount,\n          safeDivide(futureDateCount, dateValues.length),\n          \"Review whether future dates are expected for this field.\"\n        )\n      );\n\n      notes.push(\"Future date values detected.\");\n    }\n\n    if (\n      dominant.name === \"Date\" &&\n      veryOldDateCount > 0\n    ) {\n      columnIssues.push(\n        makeIssue(\n          \"Review\",\n          name,\n          \"Extremely Old Dates\",\n          `${formatInteger(veryOldDateCount)} of ` +\n          `${formatInteger(dateValues.length)} applicable date values in ` +\n          `${name} are earlier than 1900.`,\n          veryOldDateCount,\n          safeDivide(veryOldDateCount, dateValues.length),\n          \"Review whether unusually old dates are expected for this field.\"\n        )\n      );\n\n      notes.push(\"Date values earlier than 1900 detected.\");\n    }\n\n    if (\n      dominant.name === \"Date\" &&\n      ambiguousDateTextCount > 0\n    ) {\n      columnIssues.push(\n        makeIssue(\n          \"Review\",\n          name,\n          \"Ambiguous Date-like Text\",\n          `${formatInteger(ambiguousDateTextCount)} of ` +\n          `${formatInteger(populated)} populated ${name} values are text that ` +\n          \"resembles an ambiguous short date or code.\",\n          ambiguousDateTextCount,\n          safeDivide(ambiguousDateTextCount, populated),\n          \"Review whether these values are intended as dates, text, or codes.\"\n        )\n      );\n\n      notes.push(\"Ambiguous date-like text values detected.\");\n    }\n\n    const outlierCount =\n      dominant.name === \"Numeric\"\n        ? countIqrOutliers(numericValues)\n        : 0;\n\n    if (outlierCount > 0) {\n      columnIssues.push(\n        makeIssue(\n          \"Review\",\n          name,\n          \"Statistical Outliers\",\n          `${formatInteger(outlierCount)} of ` +\n          `${formatInteger(numericValues.length)} applicable numeric values in ` +\n          `${name} are potential statistical outliers using the IQR method.`,\n          outlierCount,\n          safeDivide(outlierCount, numericValues.length),\n          \"Review outliers in context. Statistical outliers are not necessarily errors.\"\n        )\n      );\n\n      notes.push(\"Potential statistical outliers detected.\");\n    }\n\n    if (\n      pattern.detected &&\n      pattern.exceptionCount > 0\n    ) {\n      columnIssues.push(\n        makeIssue(\n          pattern.conformance < 0.80 ? \"Concern\" : \"Review\",\n          name,\n          \"Pattern Inconsistency\",\n          `${formatInteger(pattern.exceptionCount)} of ` +\n          `${formatInteger(populated)} populated ${name} values do not match ` +\n          `the detected ${pattern.type} pattern.`,\n          pattern.exceptionCount,\n          safeDivide(pattern.exceptionCount, populated),\n          \"Review whether the pattern exceptions are expected. Actual values are not shown.\"\n        )\n      );\n\n      notes.push(\n        `${formatPercentText(pattern.conformance)} ` +\n        `${pattern.type} pattern conformance.`\n      );\n    }\n\n    const conversionReasons: string[] = [];\n\n    if (identifier.strongEvidence) {\n      const numericCount = integerCount + decimalCount;\n\n      if (\n        numericCount > 0 &&\n        numericCount >= populated * 0.80\n      ) {\n        conversionReasons.push(\n          \"Identifier-like values are stored numerically, so meaningful leading zeros may not be preserved.\"\n        );\n      }\n\n      if (longNumericCount > 0) {\n        conversionReasons.push(\n          \"Long numeric identifier values were detected. Excel numeric precision may affect identifiers longer than 15 digits.\"\n        );\n      }\n\n      if (scientificNotationCount > 0) {\n        conversionReasons.push(\n          \"Scientific notation was detected in an identifier-like column.\"\n        );\n      }\n\n      if (\n        structuralLengths.length >= 3 &&\n        new Set<number>(structuralLengths).size > 1\n      ) {\n        conversionReasons.push(\n          \"Identifier-like values have inconsistent lengths.\"\n        );\n      }\n    }\n\n    const conversionRisk = conversionReasons.length > 0;\n\n    if (conversionRisk) {\n      conversionRiskColumns++;\n\n      const applicableCount = Math.max(\n        longNumericCount,\n        scientificNotationCount,\n        integerCount + decimalCount\n      );\n\n      columnIssues.push(\n        makeIssue(\n          longNumericCount > 0 ? \"Concern\" : \"Review\",\n          name,\n          \"Potential Excel Conversion Risk\",\n          `${name}: ${conversionReasons.join(\" \")}`,\n          applicableCount,\n          safeDivide(applicableCount, populated),\n          \"Compare with the original source where available. The profiler cannot determine the pre-import value.\"\n        )\n      );\n\n      notes.push(\"Potential Excel conversion risk.\");\n    }\n\n    if (sensitive.detected) {\n      columnIssues.push(\n        makeIssue(\n          \"Info\",\n          name,\n          \"Potential Sensitive Data\",\n          `${name} may contain ${sensitive.type}. ` +\n          `${formatInteger(sensitive.count)} of ${formatInteger(populated)} ` +\n          \"populated values match the detected pattern. Detection is not definitive.\",\n          sensitive.count,\n          safeDivide(sensitive.count, populated),\n          \"Apply appropriate access, retention, and handling controls if confirmed.\"\n        )\n      );\n\n      notes.push(sensitive.type);\n    }\n\n    let qualityFlag: QualityFlag = \"Good\";\n\n    if (\n      columnIssues.some(\n        (issue: Issue): boolean =>\n          issue.severity === \"Concern\"\n      )\n    ) {\n      qualityFlag = \"Concern\";\n    } else if (\n      columnIssues.some(\n        (issue: Issue): boolean =>\n          issue.severity === \"Review\"\n      )\n    ) {\n      qualityFlag = \"Review\";\n    }\n\n    if (qualityFlag !== \"Good\") {\n      concernColumns++;\n    }\n\n    issues.push(...columnIssues);\n\n    results.push({\n      row: [\n        column + 1,\n        name,\n        recordCount,\n        populated,\n        blank,\n        completeness,\n        distinctCount,\n        uniqueness,\n        duplicateValueCount,\n        detectedType,\n        confidence,\n        minimum,\n        maximum,\n        lengthSummary.minimum,\n        lengthSummary.maximum,\n        lengthSummary.average,\n        commonValue,\n        commonCount,\n        commonPercent,\n        examples[0] || \"N/A\",\n        examples[1] || \"N/A\",\n        examples[2] || \"N/A\",\n        identifier.result,\n        sensitive.detected ? \"Yes\" : \"No\",\n        sensitive.detected ? sensitive.type : \"N/A\",\n        mixedTypes ? \"Yes\" : \"No\",\n        observedTypes,\n        whitespaceExceptionCount > 0 ? \"Yes\" : \"No\",\n        whitespaceExceptionCount,\n        safeDivide(\n          whitespaceExceptionCount,\n          textLengths.length\n        ),\n        conversionRisk ? \"Yes\" : \"No\",\n        pattern.detected ? pattern.type : \"N/A\",\n        pattern.detected ? pattern.matchCount : \"N/A\",\n        pattern.detected ? pattern.exceptionCount : \"N/A\",\n        pattern.detected ? pattern.conformance : \"N/A\",\n        qualityFlag,\n        notes.length > 0\n          ? uniqueStrings(notes).join(\" \")\n          : \"No significant profiling concerns.\"\n      ],\n      confidence,\n      qualityFlag,\n      identifier: identifier.result,\n      sensitive: sensitive.detected,\n      conversionRisk\n    });\n  }\n\n  return {\n    columns: results,\n    issues,\n    totalPopulated,\n    totalBlank,\n    emptyColumns,\n    concernColumns,\n    identifierColumns,\n    sensitiveColumns,\n    conversionRiskColumns,\n    consistencyScore:\n      confidenceWeight > 0\n        ? weightedConfidence / confidenceWeight\n        : 0\n  };\n}\n\nfunction detectIdentifier(\n  header: string,\n  completeness: number,\n  uniqueness: number,\n  structureStability: number,\n  populated: number,\n  integerCount: number,\n  decimalCount: number,\n  textCount: number,\n  values: string[]\n): IdentifierResult {\n  const normalizedHeader = normalizeHeader(header);\n\n  const negativeHeader =\n    /\\b(amount|price|cost|total|rate|percentage|percent|score|balance|quantity|qty|revenue|sales|income|expense|margin|average|avg|weight|height)\\b/i\n      .test(normalizedHeader);\n\n  if (negativeHeader) {\n    return {\n      result: \"No\",\n      headerIndicator: false,\n      strongEvidence: false\n    };\n  }\n\n  const headerIndicator =\n    /\\b(id|identifier|key|code|number|no|account|acct|customer|employee|order|transaction|record|product|invoice|reference|ref|uuid|guid)\\b/i\n      .test(normalizedHeader);\n\n  const numericCount = integerCount + decimalCount;\n  const decimalShare = safeDivide(\n    decimalCount,\n    numericCount\n  );\n\n  const mostlyIdentifierCompatible =\n    decimalShare <= 0.05 &&\n    safeDivide(\n      integerCount + textCount,\n      populated\n    ) >= 0.90;\n\n  const guidCount = values.filter(\n    (value: string): boolean => isGuid(value)\n  ).length;\n\n  const guidShare = safeDivide(guidCount, populated);\n\n  const strongWithHeader =\n    headerIndicator &&\n    populated > 0 &&\n    completeness >= 0.80 &&\n    uniqueness >= 0.80 &&\n    structureStability >= 0.65 &&\n    mostlyIdentifierCompatible;\n\n  const exceptionalWithoutHeader =\n    populated >= 10 &&\n    completeness >= 0.95 &&\n    uniqueness >= 0.98 &&\n    structureStability >= 0.90 &&\n    mostlyIdentifierCompatible;\n\n  if (guidShare >= 0.80 || strongWithHeader) {\n    return {\n      result: \"Yes\",\n      headerIndicator,\n      strongEvidence: true\n    };\n  }\n\n  const possible =\n    (\n      headerIndicator &&\n      completeness >= 0.70 &&\n      uniqueness >= 0.70 &&\n      structureStability >= 0.50 &&\n      mostlyIdentifierCompatible\n    ) ||\n    exceptionalWithoutHeader;\n\n  return {\n    result: possible ? \"Possible\" : \"No\",\n    headerIndicator,\n    strongEvidence: exceptionalWithoutHeader\n  };\n}\n\nfunction detectDominantPattern(\n  header: string,\n  values: string[]\n): PatternResult {\n  if (values.length === 0) {\n    return emptyPatternResult();\n  }\n\n  const normalizedHeader = normalizeHeader(header);\n\n  const identifierHeader =\n    /\\b(account|acct|customer id|employee id|order number|product id|transaction id|record id|identifier|uuid|guid)\\b/i\n      .test(normalizedHeader);\n\n  const phoneHeader =\n    /\\b(phone|phone number|telephone|mobile|cell|tel)\\b/i\n      .test(normalizedHeader);\n\n  const definitions = getPatternDefinitions();\n  let bestResult = emptyPatternResult();\n  let bestScore = 0;\n\n  for (const definition of definitions) {\n    let matchCount = 0;\n\n    for (const value of values) {\n      if (definition.test(value)) {\n        matchCount++;\n      }\n    }\n\n    const conformance = safeDivide(\n      matchCount,\n      values.length\n    );\n\n    const headerMatch = definition.headerPattern.test(\n      normalizedHeader\n    );\n\n    /*\n     * Preserve the account-number safeguard.\n     */\n    if (\n      definition.type === \"Phone\" &&\n      identifierHeader &&\n      !phoneHeader\n    ) {\n      continue;\n    }\n\n    /*\n     * A high-confidence header permits sparse columns. Conformance is\n     * always based on populated values, not total records.\n     */\n    const strongHeaderSupport =\n      headerMatch &&\n      matchCount >= 1 &&\n      conformance >= 0.75;\n\n    const strongValueSupport =\n      matchCount >= 3 &&\n      conformance >= 0.85;\n\n    const headerlessAllowed =\n      !definition.requireHeaderWithoutStrongEvidence;\n\n    const detected =\n      strongHeaderSupport ||\n      (\n        headerlessAllowed &&\n        strongValueSupport\n      );\n\n    if (!detected) {\n      continue;\n    }\n\n    const score =\n      conformance +\n      (headerMatch ? 0.25 : 0);\n\n    if (score > bestScore) {\n      bestScore = score;\n\n      bestResult = {\n        type: definition.type,\n        sensitiveType: definition.sensitiveType,\n        matchCount,\n        exceptionCount: values.length - matchCount,\n        conformance,\n        detected: true\n      };\n    }\n  }\n\n  return bestResult;\n}\n\nfunction detectSensitiveData(\n  values: string[],\n  pattern: PatternResult\n): SensitiveResult {\n  if (values.length === 0) {\n    return {\n      detected: false,\n      type: \"N/A\",\n      count: 0\n    };\n  }\n\n  if (\n    pattern.detected &&\n    pattern.sensitiveType !== \"N/A\"\n  ) {\n    return {\n      detected: true,\n      type: pattern.sensitiveType,\n      count: pattern.matchCount\n    };\n  }\n\n  return {\n    detected: false,\n    type: \"N/A\",\n    count: 0\n  };\n}\n\nfunction getPatternDefinitions(): PatternDefinition[] {\n  return [\n    {\n      type: \"Email\",\n      sensitiveType: \"Potential Email Address\",\n      headerPattern:\n        /\\b(email|email address|e mail)\\b/i,\n      test: (value: string): boolean =>\n        /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/i.test(value)\n    },\n    {\n      type: \"Phone\",\n      sensitiveType: \"Potential Phone Number\",\n      headerPattern:\n        /\\b(phone|phone number|telephone|mobile|cell|tel)\\b/i,\n      test: (value: string): boolean =>\n        isPhone(value)\n    },\n    {\n      type: \"IPv4\",\n      sensitiveType: \"Potential IP Address\",\n      headerPattern:\n        /\\b(ip|ip address|ipv4)\\b/i,\n      test: (value: string): boolean =>\n        isIPv4(value)\n    },\n    {\n      type: \"SSN\",\n      sensitiveType: \"Potential SSN Pattern\",\n      headerPattern:\n        /\\b(ssn|social security|social security number)\\b/i,\n      test: (value: string): boolean =>\n        isSsn(value)\n    },\n    {\n      type: \"Tax ID/EIN\",\n      sensitiveType: \"Potential Tax ID Pattern\",\n      headerPattern:\n        /\\b(tax id|tax identifier|ein|employer identification number)\\b/i,\n      test: (value: string): boolean =>\n        isEin(value) || isSsn(value),\n      requireHeaderWithoutStrongEvidence: true\n    },\n    {\n      type: \"Credit Card\",\n      sensitiveType: \"Potential Credit Card Pattern\",\n      headerPattern:\n        /\\b(credit card|card number|payment card|card no|pan)\\b/i,\n      test: (value: string): boolean =>\n        isCreditCardLike(value),\n      requireHeaderWithoutStrongEvidence: true\n    },\n    {\n      type: \"UUID/GUID\",\n      sensitiveType: \"N/A\",\n      headerPattern:\n        /\\b(uuid|guid)\\b/i,\n      test: (value: string): boolean =>\n        isGuid(value)\n    }\n  ];\n}\n\nfunction writeSummarySheet(\n  summarySheet: ExcelScript.Worksheet,\n  sourceName: string,\n  sourceAddress: string,\n  recordCount: number,\n  columnCount: number,\n  duplicateRecords: number,\n  duplicatePercent: number,\n  completeness: number,\n  profile: ProfileResults\n) {\n  const profileTime = new Date()\n    .toISOString()\n    .replace(\"T\", \" \")\n    .replace(\"Z\", \" UTC\");\n\n  const overview: CellValue[][] = [\n    [\"DATASET OVERVIEW\", \"\"],\n    [\"Source worksheet\", sourceName],\n    [\"Profile date/time\", profileTime],\n    [\"Total records (excluding header)\", recordCount],\n    [\"Total columns\", columnCount],\n    [\"Total populated cells\", profile.totalPopulated],\n    [\"Total blank/null cells\", profile.totalBlank],\n    [\"Overall completeness\", completeness],\n    [\"Completely empty columns\", profile.emptyColumns],\n    [\"Duplicate records\", duplicateRecords],\n    [\"Duplicate record percentage\", duplicatePercent],\n    [\"Columns with quality concerns\", profile.concernColumns],\n    [\n      \"Mixed data type issues\",\n      countIssuesByType(profile.issues, \"Mixed Data Types\")\n    ],\n    [\n      \"Pattern inconsistency issues\",\n      countIssuesByType(profile.issues, \"Pattern Inconsistency\")\n    ],\n    [\n      \"Excel error issues\",\n      countIssuesByType(profile.issues, \"Excel Error Values\")\n    ],\n    [\n      \"Whitespace issues\",\n      countIssuesByType(profile.issues, \"Whitespace\")\n    ],\n    [\"Potential identifier columns\", profile.identifierColumns],\n    [\"Potential sensitive-data columns\", profile.sensitiveColumns],\n    [\n      \"Excel formatting/conversion risks\",\n      profile.conversionRiskColumns\n    ]\n  ];\n\n  summarySheet.getRange(\"A1:C1\").merge();\n  summarySheet.getRange(\"A1\").setValue(\n    \"DATA PROFILE SUMMARY\"\n  );\n\n  summarySheet.getRange(\"A2:C2\").merge();\n  summarySheet.getRange(\"A2\").setValue(\n    `Structural and statistical profile of \"${sourceName}\" (${sourceAddress})`\n  );\n\n  summarySheet.getRange(\"A4:C4\").merge();\n  summarySheet.getRange(\"A4\").setValue(\n    \"This profiler identifies structural and statistical characteristics and potential review items. \" +\n    \"It does not determine whether data is correct for its intended business purpose.\"\n  );\n\n  summarySheet.getRangeByIndexes(\n    5,\n    0,\n    overview.length,\n    2\n  ).setValues(overview);\n\n  /*\n   * Exact summary formats:\n   * B13 and B16 are percentages. All listed count cells are integers.\n   */\n  summarySheet.getRange(\"B9:B12\")\n    .setNumberFormat(\"#,##0\");\n\n  summarySheet.getRange(\"B13\")\n    .setNumberFormat(\"0.0%\");\n\n  summarySheet.getRange(\"B14:B15\")\n    .setNumberFormat(\"#,##0\");\n\n  summarySheet.getRange(\"B16\")\n    .setNumberFormat(\"0.0%\");\n\n  summarySheet.getRange(\"B17:B24\")\n    .setNumberFormat(\"#,##0\");\n\n  const concernsStart = 26;\n\n  summarySheet.getRangeByIndexes(\n    concernsStart,\n    0,\n    1,\n    3\n  ).setValues([\n    [\n      \"TOP DATA QUALITY CONCERNS\",\n      \"SEVERITY\",\n      \"DETAIL\"\n    ]\n  ]);\n\n  const topIssues = profile.issues\n    .slice()\n    .sort(\n      (first: Issue, second: Issue): number => {\n        const difference =\n          severityRank(second.severity) -\n          severityRank(first.severity);\n\n        return difference !== 0\n          ? difference\n          : second.percent - first.percent;\n      }\n    )\n    .slice(0, 10);\n\n  const concernRows: CellValue[][] =\n    topIssues.length > 0\n      ? topIssues.map(\n        (issue: Issue): CellValue[] => [\n          `${issue.column}: ${issue.issueType}`,\n          issue.severity,\n          issue.description\n        ]\n      )\n      : [\n        [\n          \"No significant structural concerns detected\",\n          \"Info\",\n          \"No significant structural or statistical concerns were identified.\"\n        ]\n      ];\n\n  summarySheet.getRangeByIndexes(\n    concernsStart + 1,\n    0,\n    concernRows.length,\n    3\n  ).setValues(concernRows);\n\n  applyTitleFormatting(\n    summarySheet,\n    \"A1:C1\",\n    \"A2:C2\"\n  );\n\n  applySectionHeader(\n    summarySheet.getRange(\"A6:B6\")\n  );\n\n  applySectionHeader(\n    summarySheet.getRangeByIndexes(\n      concernsStart,\n      0,\n      1,\n      3\n    )\n  );\n\n  summarySheet.getRange(\"A4:C4\")\n    .getFormat()\n    .getFill()\n    .setColor(\"#FFF2CC\");\n\n  summarySheet.getRange(\"A4:C4\")\n    .getFormat()\n    .getFont()\n    .setColor(\"#7F6000\");\n\n  summarySheet.getRange(\"A4:C4\")\n    .getFormat()\n    .getFont()\n    .setBold(true);\n\n  summarySheet.getRange(\"A4:C4\")\n    .getFormat()\n    .setWrapText(true);\n\n  const concernTable = summarySheet.addTable(\n    summarySheet.getRangeByIndexes(\n      concernsStart,\n      0,\n      concernRows.length + 1,\n      3\n    ),\n    true\n  );\n\n  concernTable.setName(\"ProfilerTopConcerns\");\n\n  summarySheet.getFreezePanes().freezeRows(2);\n  summarySheet.getUsedRange().getFormat().autofitColumns();\n  summarySheet.getUsedRange().getFormat().autofitRows();\n\n  summarySheet.getRange(\"A:A\")\n    .getFormat()\n    .setColumnWidth(220);\n\n  summarySheet.getRange(\"B:B\")\n    .getFormat()\n    .setColumnWidth(130);\n\n  summarySheet.getRange(\"C:C\")\n    .getFormat()\n    .setColumnWidth(330);\n\n  summarySheet.getRange(\"C:C\")\n    .getFormat()\n    .setWrapText(true);\n}\n\nfunction writeColumnProfileSheet(\n  columnProfileSheet: ExcelScript.Worksheet,\n  columns: ColumnResult[]\n) {\n  const headers: CellValue[] = [\n    \"Column Number\",\n    \"Column Name\",\n    \"Record Count\",\n    \"Populated Count\",\n    \"Blank Count\",\n    \"Completeness %\",\n    \"Distinct Count\",\n    \"Uniqueness %\",\n    \"Duplicate Value Count\",\n    \"Detected Data Type\",\n    \"Data Type Confidence %\",\n    \"Minimum Value\",\n    \"Maximum Value\",\n    \"Minimum Length\",\n    \"Maximum Length\",\n    \"Average Length\",\n    \"Most Common Value\",\n    \"Most Common Value Count\",\n    \"Most Common Value %\",\n    \"Example Value 1\",\n    \"Example Value 2\",\n    \"Example Value 3\",\n    \"Potential Identifier?\",\n    \"Potential Sensitive Data?\",\n    \"Sensitive Data Type\",\n    \"Mixed Data Types?\",\n    \"Observed Types\",\n    \"Leading/Trailing Whitespace?\",\n    \"Whitespace Exception Count\",\n    \"Whitespace Exception %\",\n    \"Potential Excel Conversion Risk?\",\n    \"Pattern Type\",\n    \"Pattern Match Count\",\n    \"Pattern Exception Count\",\n    \"Pattern Conformance %\",\n    \"Quality Flag\",\n    \"Quality Notes\"\n  ];\n\n  const rows = columns.map(\n    (column: ColumnResult): CellValue[] =>\n      column.row\n  );\n\n  const allRows = [headers, ...rows];\n\n  columnProfileSheet.getRangeByIndexes(\n    0,\n    0,\n    allRows.length,\n    headers.length\n  ).setValues(allRows);\n\n  if (rows.length > 0) {\n    const table = columnProfileSheet.addTable(\n      columnProfileSheet.getRangeByIndexes(\n        0,\n        0,\n        allRows.length,\n        headers.length\n      ),\n      true\n    );\n\n    table.setName(\"ColumnProfileTable\");\n\n    const percentageColumns = [\n      5, 7, 10, 18, 29, 34\n    ];\n\n    for (const columnIndex of percentageColumns) {\n      columnProfileSheet.getRangeByIndexes(\n        1,\n        columnIndex,\n        rows.length,\n        1\n      ).setNumberFormat(\"0.0%\");\n    }\n\n    const countColumns = [\n      2, 3, 4, 6, 8, 17, 28, 32, 33\n    ];\n\n    for (const columnIndex of countColumns) {\n      columnProfileSheet.getRangeByIndexes(\n        1,\n        columnIndex,\n        rows.length,\n        1\n      ).setNumberFormat(\"#,##0\");\n    }\n  } else {\n    applySectionHeader(\n      columnProfileSheet.getRangeByIndexes(\n        0,\n        0,\n        1,\n        headers.length\n      )\n    );\n  }\n\n  columnProfileSheet.getFreezePanes().freezeRows(1);\n  columnProfileSheet.getUsedRange()\n    .getFormat()\n    .autofitColumns();\n\n  columnProfileSheet.getUsedRange()\n    .getFormat()\n    .autofitRows();\n\n  capColumnWidth(columnProfileSheet, 1, 180);\n  capColumnWidth(columnProfileSheet, 16, 180);\n  capColumnWidth(columnProfileSheet, 19, 170);\n  capColumnWidth(columnProfileSheet, 20, 170);\n  capColumnWidth(columnProfileSheet, 21, 170);\n  capColumnWidth(columnProfileSheet, 24, 180);\n  capColumnWidth(columnProfileSheet, 26, 220);\n  capColumnWidth(columnProfileSheet, 36, 300);\n\n  columnProfileSheet.getRange(\"AK:AK\")\n    .getFormat()\n    .setWrapText(true);\n}\n\nfunction writeIssueSheet(\n  issuesSheet: ExcelScript.Worksheet,\n  issues: Issue[]\n) {\n  const headers: CellValue[] = [\n    \"Issue Number\",\n    \"Severity\",\n    \"Column\",\n    \"Issue Type\",\n    \"Description\",\n    \"Records Affected\",\n    \"Percent of Applicable Values\",\n    \"Recommended Review\"\n  ];\n\n  const sortedIssues = issues\n    .slice()\n    .sort(\n      (first: Issue, second: Issue): number => {\n        const difference =\n          severityRank(second.severity) -\n          severityRank(first.severity);\n\n        if (difference !== 0) {\n          return difference;\n        }\n\n        if (first.column !== second.column) {\n          return first.column.localeCompare(\n            second.column\n          );\n        }\n\n        return first.issueType.localeCompare(\n          second.issueType\n        );\n      }\n    );\n\n  const rows: CellValue[][] = sortedIssues.map(\n    (issue: Issue, index: number): CellValue[] => [\n      index + 1,\n      issue.severity,\n      issue.column,\n      issue.issueType,\n      issue.description,\n      issue.affected,\n      issue.percent,\n      issue.recommendation\n    ]\n  );\n\n  if (rows.length === 0) {\n    rows.push([\n      1,\n      \"Info\",\n      \"Dataset\",\n      \"No Significant Concerns\",\n      \"No significant structural or statistical concerns were detected.\",\n      0,\n      0,\n      \"Continue applying appropriate business-rule validation.\"\n    ]);\n  }\n\n  const allRows = [headers, ...rows];\n\n  issuesSheet.getRangeByIndexes(\n    0,\n    0,\n    allRows.length,\n    headers.length\n  ).setValues(allRows);\n\n  const table = issuesSheet.addTable(\n    issuesSheet.getRangeByIndexes(\n      0,\n      0,\n      allRows.length,\n      headers.length\n    ),\n    true\n  );\n\n  table.setName(\"DataQualityIssuesTable\");\n\n  issuesSheet.getRangeByIndexes(\n    1,\n    5,\n    rows.length,\n    1\n  ).setNumberFormat(\"#,##0\");\n\n  issuesSheet.getRangeByIndexes(\n    1,\n    6,\n    rows.length,\n    1\n  ).setNumberFormat(\"0.0%\");\n\n  issuesSheet.getFreezePanes().freezeRows(1);\n  issuesSheet.getUsedRange().getFormat().autofitColumns();\n  issuesSheet.getUsedRange().getFormat().autofitRows();\n\n  capColumnWidth(issuesSheet, 2, 180);\n  capColumnWidth(issuesSheet, 3, 180);\n  capColumnWidth(issuesSheet, 4, 330);\n  capColumnWidth(issuesSheet, 7, 330);\n\n  issuesSheet.getRange(\"E:E\")\n    .getFormat()\n    .setWrapText(true);\n\n  issuesSheet.getRange(\"H:H\")\n    .getFormat()\n    .setWrapText(true);\n}\n\nfunction verifySourceUnchanged(\n  sourceWorksheet: ExcelScript.Worksheet,\n  snapshot: SourceSnapshot | null\n) {\n  const currentRange = sourceWorksheet.getUsedRange(true);\n\n  if (snapshot === null) {\n    if (currentRange) {\n      throw new Error(\n        \"Profiler safety check failed: the previously empty source worksheet was modified unexpectedly.\"\n      );\n    }\n\n    return;\n  }\n\n  if (!currentRange) {\n    throw new Error(\n      \"Profiler safety check failed: source data is no longer present.\"\n    );\n  }\n\n  if (\n    currentRange.getAddress() !== snapshot.address ||\n    currentRange.getRowCount() !== snapshot.rowCount ||\n    currentRange.getColumnCount() !== snapshot.columnCount\n  ) {\n    throw new Error(\n      \"Profiler safety check failed: source worksheet structure was modified unexpectedly.\"\n    );\n  }\n\n  const currentValues = currentRange.getValues();\n  const currentFormulas = currentRange.getFormulas();\n  const currentNumberFormats =\n    currentRange.getNumberFormats();\n\n  for (let row = 0; row < snapshot.rowCount; row++) {\n    for (\n      let column = 0;\n      column < snapshot.columnCount;\n      column++\n    ) {\n      const originalFormula =\n        snapshot.formulas[row][column];\n\n      const currentFormula =\n        currentFormulas[row][column];\n\n      const originallyFormulaCell =\n        isFormulaEntry(originalFormula);\n\n      const currentlyFormulaCell =\n        isFormulaEntry(currentFormula);\n\n      if (\n        originallyFormulaCell !== currentlyFormulaCell\n      ) {\n        throw new Error(\n          \"Profiler safety check failed: a source formula was added, removed, or replaced.\"\n        );\n      }\n\n      if (originallyFormulaCell) {\n        if (originalFormula !== currentFormula) {\n          throw new Error(\n            \"Profiler safety check failed: a source formula was modified unexpectedly.\"\n          );\n        }\n      } else if (\n        !cellValuesEqual(\n          snapshot.values[row][column],\n          currentValues[row][column]\n        )\n      ) {\n        throw new Error(\n          \"Profiler safety check failed: a source value was modified unexpectedly.\"\n        );\n      }\n\n      if (\n        snapshot.numberFormats[row][column] !==\n        currentNumberFormats[row][column]\n      ) {\n        throw new Error(\n          \"Profiler safety check failed: a source number format was modified unexpectedly.\"\n        );\n      }\n    }\n  }\n}\n\nfunction classifyValue(\n  value: CellValue,\n  text: string,\n  valueType: ExcelScript.RangeValueType,\n  numberFormat: string\n): ClassifiedValue {\n  if (\n    valueType === ExcelScript.RangeValueType.error ||\n    isErrorText(text)\n  ) {\n    return { family: \"Error\", detail: \"Error\" };\n  }\n\n  if (typeof value === \"boolean\") {\n    return { family: \"Boolean\", detail: \"Boolean\" };\n  }\n\n  if (typeof value === \"number\") {\n    if (\n      isDateNumberFormat(numberFormat) &&\n      isValidExcelDateSerial(value)\n    ) {\n      const date = excelSerialToDate(value);\n      const hasTime =\n        hasTimeFormat(numberFormat) ||\n        Math.abs(value - Math.floor(value)) > 0.0000001;\n\n      return {\n        family: \"Date\",\n        detail: hasTime ? \"DateTime\" : \"Date\",\n        dateValue: date\n      };\n    }\n\n    return {\n      family: \"Numeric\",\n      detail: Number.isInteger(value)\n        ? \"Integer\"\n        : \"Decimal\",\n      numericValue: value\n    };\n  }\n\n  const parsedDate = parseConservativeDate(value);\n\n  if (parsedDate) {\n    return {\n      family: \"Date\",\n      detail: parsedDate.hasTime\n        ? \"DateTime\"\n        : \"Date\",\n      dateValue: parsedDate.date\n    };\n  }\n\n  return { family: \"Text\", detail: \"Text\" };\n}\n\nfunction buildDisplayHeaders(\n  sourceHeaders: CellValue[],\n  columnCount: number\n): string[] {\n  const baseNames: string[] = [];\n  const totals = new Map<string, number>();\n\n  for (let column = 0; column < columnCount; column++) {\n    const raw =\n      column < sourceHeaders.length\n        ? String(sourceHeaders[column]).trim()\n        : \"\";\n\n    const base =\n      raw || `Unnamed Column ${column + 1}`;\n\n    baseNames.push(base);\n\n    const key = base.toLowerCase();\n\n    totals.set(\n      key,\n      (totals.get(key) || 0) + 1\n    );\n  }\n\n  const seen = new Map<string, number>();\n\n  return baseNames.map(\n    (base: string, index: number): string => {\n      const key = base.toLowerCase();\n      const occurrence =\n        (seen.get(key) || 0) + 1;\n\n      seen.set(key, occurrence);\n\n      if (\n        (totals.get(key) || 0) > 1 &&\n        occurrence > 1\n      ) {\n        return `${base} [Column ${index + 1}]`;\n      }\n\n      return base;\n    }\n  );\n}\n\nfunction addHeaderIssues(\n  name: string,\n  column: number,\n  issues: Issue[],\n  notes: string[]\n) {\n  if (name === `Unnamed Column ${column + 1}`) {\n    issues.push(\n      makeIssue(\n        \"Review\",\n        name,\n        \"Missing Header\",\n        `Source column ${column + 1} has a blank or whitespace-only header.`,\n        1,\n        1,\n        \"Review the source header. The profiler did not modify it.\"\n      )\n    );\n\n    notes.push(\"Source header is blank.\");\n  }\n\n  if (/\\[Column \\d+\\]$/.test(name)) {\n    issues.push(\n      makeIssue(\n        \"Review\",\n        name,\n        \"Duplicate Header\",\n        `${name} was assigned a report-only suffix because its source header is duplicated.`,\n        1,\n        1,\n        \"Review whether duplicate source headers are intentional.\"\n      )\n    );\n\n    notes.push(\"Duplicate source header.\");\n  }\n}\n\nfunction refreshOutputSheets(\n  workbook: ExcelScript.Workbook,\n  names: string[]\n) {\n  for (const name of names) {\n    const reportSheet = workbook.getWorksheet(name);\n\n    if (reportSheet) {\n      reportSheet.delete();\n    }\n  }\n}\n\nfunction cloneCellMatrix(\n  source: CellValue[][]\n): CellValue[][] {\n  const copy: CellValue[][] = [];\n\n  for (const row of source) {\n    copy.push(row.slice());\n  }\n\n  return copy;\n}\n\nfunction cloneStringMatrix(\n  source: string[][]\n): string[][] {\n  const copy: string[][] = [];\n\n  for (const row of source) {\n    copy.push(row.slice());\n  }\n\n  return copy;\n}\n\nfunction isFormulaEntry(\n  value: CellValue\n): boolean {\n  return typeof value === \"string\" &&\n    value.startsWith(\"=\");\n}\n\nfunction cellValuesEqual(\n  first: CellValue,\n  second: CellValue\n): boolean {\n  return (\n    typeof first === typeof second &&\n    String(first) === String(second)\n  );\n}\n\nfunction countDuplicateRows(\n  values: CellValue[][]\n): number {\n  if (values.length <= 2) {\n    return 0;\n  }\n\n  const seen = new Set<string>();\n  let duplicates = 0;\n\n  for (let row = 1; row < values.length; row++) {\n    const serialized = JSON.stringify(values[row]);\n\n    if (seen.has(serialized)) {\n      duplicates++;\n    } else {\n      seen.add(serialized);\n    }\n  }\n\n  return duplicates;\n}\n\nfunction countIqrOutliers(\n  values: number[]\n): number {\n  if (values.length < 8) {\n    return 0;\n  }\n\n  const sampleLimit = 20000;\n  const sample: number[] = [];\n\n  if (values.length <= sampleLimit) {\n    sample.push(...values);\n  } else {\n    const step = values.length / sampleLimit;\n\n    for (let index = 0; index < sampleLimit; index++) {\n      sample.push(\n        values[Math.floor(index * step)]\n      );\n    }\n  }\n\n  sample.sort(\n    (first: number, second: number): number =>\n      first - second\n  );\n\n  const q1 = percentile(sample, 0.25);\n  const q3 = percentile(sample, 0.75);\n  const iqr = q3 - q1;\n\n  if (iqr === 0) {\n    return 0;\n  }\n\n  const lower = q1 - 1.5 * iqr;\n  const upper = q3 + 1.5 * iqr;\n  let count = 0;\n\n  for (const value of values) {\n    if (value < lower || value > upper) {\n      count++;\n    }\n  }\n\n  return count;\n}\n\nfunction countLengthAnomalies(\n  lengths: number[]\n): number {\n  if (lengths.length < 5) {\n    return 0;\n  }\n\n  const counts = new Map<number, number>();\n  let mode = 0;\n  let modeCount = 0;\n\n  for (const length of lengths) {\n    const count = (counts.get(length) || 0) + 1;\n    counts.set(length, count);\n\n    if (count > modeCount) {\n      mode = length;\n      modeCount = count;\n    }\n  }\n\n  if (safeDivide(modeCount, lengths.length) < 0.50) {\n    return 0;\n  }\n\n  const tolerance = Math.max(2, mode * 0.50);\n  let anomalies = 0;\n\n  for (const length of lengths) {\n    if (Math.abs(length - mode) > tolerance) {\n      anomalies++;\n    }\n  }\n\n  return anomalies;\n}\n\nfunction calculateStructureStability(\n  shapeCounts: Map<string, number>,\n  lengths: number[],\n  populated: number\n): number {\n  let maximumShapeCount = 0;\n\n  shapeCounts.forEach(\n    (count: number): void => {\n      if (count > maximumShapeCount) {\n        maximumShapeCount = count;\n      }\n    }\n  );\n\n  const shapeStability = safeDivide(\n    maximumShapeCount,\n    populated\n  );\n\n  if (lengths.length === 0) {\n    return shapeStability;\n  }\n\n  const lengthCounts = new Map<number, number>();\n  let maximumLengthCount = 0;\n\n  for (const length of lengths) {\n    const count =\n      (lengthCounts.get(length) || 0) + 1;\n\n    lengthCounts.set(length, count);\n\n    if (count > maximumLengthCount) {\n      maximumLengthCount = count;\n    }\n  }\n\n  return Math.max(\n    shapeStability,\n    safeDivide(maximumLengthCount, lengths.length)\n  );\n}\n\nfunction summarizeLengths(\n  lengths: number[]\n): {\n  minimum: CellValue;\n  maximum: CellValue;\n  average: CellValue;\n} {\n  if (lengths.length === 0) {\n    return {\n      minimum: \"N/A\",\n      maximum: \"N/A\",\n      average: \"N/A\"\n    };\n  }\n\n  let minimum = lengths[0];\n  let maximum = lengths[0];\n  let total = 0;\n\n  for (const length of lengths) {\n    if (length < minimum) minimum = length;\n    if (length > maximum) maximum = length;\n    total += length;\n  }\n\n  return {\n    minimum,\n    maximum,\n    average: roundTo(\n      total / lengths.length,\n      1\n    )\n  };\n}\n\nfunction getNumberBounds(\n  values: number[]\n): {\n  minimum: number;\n  maximum: number;\n} {\n  let minimum = values[0];\n  let maximum = values[0];\n\n  for (const value of values) {\n    if (value < minimum) minimum = value;\n    if (value > maximum) maximum = value;\n  }\n\n  return { minimum, maximum };\n}\n\nfunction getDateBounds(\n  values: Date[]\n): {\n  minimum: Date;\n  maximum: Date;\n} {\n  let minimumTime = values[0].getTime();\n  let maximumTime = minimumTime;\n\n  for (const value of values) {\n    const time = value.getTime();\n\n    if (time < minimumTime) minimumTime = time;\n    if (time > maximumTime) maximumTime = time;\n  }\n\n  return {\n    minimum: new Date(minimumTime),\n    maximum: new Date(maximumTime)\n  };\n}\n\nfunction isPhone(value: string): boolean {\n  if (!/^[+()\\d.\\-\\s]+$/.test(value)) {\n    return false;\n  }\n\n  const digits = value.replace(/\\D/g, \"\");\n\n  return digits.length >= 10 &&\n    digits.length <= 15;\n}\n\nfunction isIPv4(value: string): boolean {\n  const parts = value.trim().split(\".\");\n\n  if (parts.length !== 4) {\n    return false;\n  }\n\n  return parts.every(\n    (part: string): boolean =>\n      /^\\d{1,3}$/.test(part) &&\n      Number(part) >= 0 &&\n      Number(part) <= 255 &&\n      (part === \"0\" || !part.startsWith(\"0\"))\n  );\n}\n\nfunction isSsn(value: string): boolean {\n  return /^(?!000|666|9\\d\\d)\\d{3}[- ]?(?!00)\\d{2}[- ]?(?!0000)\\d{4}$/\n    .test(value);\n}\n\nfunction isEin(value: string): boolean {\n  return /^\\d{2}-?\\d{7}$/.test(value);\n}\n\nfunction isGuid(value: string): boolean {\n  return /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i\n    .test(value);\n}\n\nfunction isCreditCardLike(\n  value: string\n): boolean {\n  if (!/^[\\d\\s-]+$/.test(value)) {\n    return false;\n  }\n\n  const digits = value.replace(/[\\s-]/g, \"\");\n\n  return /^\\d{13,19}$/.test(digits) &&\n    passesLuhn(digits);\n}\n\nfunction passesLuhn(digits: string): boolean {\n  let sum = 0;\n  let doubleDigit = false;\n\n  for (\n    let index = digits.length - 1;\n    index >= 0;\n    index--\n  ) {\n    let digit = Number(digits[index]);\n\n    if (doubleDigit) {\n      digit *= 2;\n\n      if (digit > 9) {\n        digit -= 9;\n      }\n    }\n\n    sum += digit;\n    doubleDigit = !doubleDigit;\n  }\n\n  return sum > 0 && sum % 10 === 0;\n}\n\nfunction emptyPatternResult(): PatternResult {\n  return {\n    type: \"N/A\",\n    sensitiveType: \"N/A\",\n    matchCount: 0,\n    exceptionCount: 0,\n    conformance: 0,\n    detected: false\n  };\n}\n\nfunction isDateNumberFormat(\n  format: string\n): boolean {\n  if (!format) {\n    return false;\n  }\n\n  const cleaned = format\n    .toLowerCase()\n    .replace(/\"[^\"]*\"/g, \"\")\n    .replace(/\\[[^\\]]*\\]/g, \"\");\n\n  return (\n    /y|d/.test(cleaned) ||\n    /m[\\/\\-.]|[\\/\\-.]m/.test(cleaned)\n  );\n}\n\nfunction hasTimeFormat(\n  format: string\n): boolean {\n  const cleaned = format\n    .toLowerCase()\n    .replace(/\"[^\"]*\"/g, \"\");\n\n  return /h|s/.test(cleaned);\n}\n\nfunction isValidExcelDateSerial(\n  value: number\n): boolean {\n  return Number.isFinite(value) &&\n    value >= 1 &&\n    value <= 2958465;\n}\n\nfunction excelSerialToDate(\n  serial: number\n): Date {\n  return new Date(\n    Math.round((serial - 25569) * 86400000)\n  );\n}\n\nfunction parseConservativeDate(\n  input: string\n): {\n  date: Date;\n  hasTime: boolean;\n} | null {\n  const value = input.trim();\n\n  let match = value.match(\n    /^(\\d{4})[-\\/](\\d{1,2})[-\\/](\\d{1,2})(?:[T\\s](\\d{1,2}):(\\d{2})(?::(\\d{2}))?)?$/\n  );\n\n  if (match) {\n    return buildValidatedDate(\n      Number(match[1]),\n      Number(match[2]),\n      Number(match[3]),\n      Number(match[4] || 0),\n      Number(match[5] || 0),\n      Number(match[6] || 0),\n      Boolean(match[4])\n    );\n  }\n\n  match = value.match(\n    /^(\\d{1,2})[-\\/](\\d{1,2})[-\\/](\\d{4})(?:[T\\s](\\d{1,2}):(\\d{2})(?::(\\d{2}))?)?$/\n  );\n\n  if (match) {\n    const first = Number(match[1]);\n    const second = Number(match[2]);\n\n    if (first <= 12 && second <= 12) {\n      return null;\n    }\n\n    const day = first > 12 ? first : second;\n    const month = first > 12 ? second : first;\n\n    return buildValidatedDate(\n      Number(match[3]),\n      month,\n      day,\n      Number(match[4] || 0),\n      Number(match[5] || 0),\n      Number(match[6] || 0),\n      Boolean(match[4])\n    );\n  }\n\n  return null;\n}\n\nfunction buildValidatedDate(\n  year: number,\n  month: number,\n  day: number,\n  hour: number,\n  minute: number,\n  second: number,\n  hasTime: boolean\n): {\n  date: Date;\n  hasTime: boolean;\n} | null {\n  if (\n    year < 100 ||\n    month < 1 ||\n    month > 12 ||\n    day < 1 ||\n    day > 31 ||\n    hour < 0 ||\n    hour > 23 ||\n    minute < 0 ||\n    minute > 59 ||\n    second < 0 ||\n    second > 59\n  ) {\n    return null;\n  }\n\n  const date = new Date(\n    Date.UTC(\n      year,\n      month - 1,\n      day,\n      hour,\n      minute,\n      second\n    )\n  );\n\n  if (\n    date.getUTCFullYear() !== year ||\n    date.getUTCMonth() !== month - 1 ||\n    date.getUTCDate() !== day\n  ) {\n    return null;\n  }\n\n  return { date, hasTime };\n}\n\nfunction resemblesAmbiguousShortDate(\n  value: string\n): boolean {\n  return /^\\d{1,2}[\\/\\-.]\\d{1,2}(?:[\\/\\-.]\\d{2,4})?$/\n    .test(value);\n}\n\nfunction isBlank(\n  value: CellValue,\n  valueType: ExcelScript.RangeValueType\n): boolean {\n  if (\n    valueType === ExcelScript.RangeValueType.error\n  ) {\n    return false;\n  }\n\n  return typeof value === \"string\" &&\n    value.trim().length === 0;\n}\n\nfunction isErrorText(value: string): boolean {\n  return /^#(N\\/A|VALUE!|REF!|DIV\\/0!|NAME\\?|NUM!|NULL!|SPILL!|CALC!)/i\n    .test(value.trim());\n}\n\nfunction containsUnusualCharacters(\n  value: string\n): boolean {\n  return /[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\uFFFD]/\n    .test(value);\n}\n\nfunction canonicalValue(\n  value: CellValue,\n  valueType: ExcelScript.RangeValueType\n): string {\n  if (\n    valueType === ExcelScript.RangeValueType.error\n  ) {\n    return `error:${String(value)}`;\n  }\n\n  return `${typeof value}:${String(value)}`;\n}\n\nfunction safeDisplayValue(\n  text: string,\n  value: CellValue\n): string {\n  const display = (text || String(value))\n    .replace(/[\\r\\n]+/g, \" \")\n    .trim();\n\n  return display.length > 120\n    ? `${display.substring(0, 117)}...`\n    : display;\n}\n\nfunction valueShape(value: string): string {\n  let result = \"\";\n\n  for (\n    let index = 0;\n    index < Math.min(value.length, 64);\n    index++\n  ) {\n    const character = value[index];\n\n    if (/[A-Za-z]/.test(character)) {\n      result += \"A\";\n    } else if (/\\d/.test(character)) {\n      result += \"9\";\n    } else if (/\\s/.test(character)) {\n      result += \" \";\n    } else {\n      result += character;\n    }\n  }\n\n  return result;\n}\n\nfunction getNumericDigitLength(\n  value: number,\n  display: string\n): number {\n  const displayedDigits = display.replace(\n    /[^0-9]/g,\n    \"\"\n  );\n\n  if (displayedDigits.length > 0) {\n    return displayedDigits.length;\n  }\n\n  return Math.abs(value)\n    .toString()\n    .replace(/[^0-9]/g, \"\")\n    .length;\n}\n\nfunction normalizeHeader(header: string): string {\n  return header\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .toLowerCase()\n    .replace(/[_-]+/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nfunction countIssuesByType(\n  issues: Issue[],\n  issueType: string\n): number {\n  return issues.filter(\n    (issue: Issue): boolean =>\n      issue.issueType === issueType\n  ).length;\n}\n\nfunction applyTitleFormatting(\n  sheet: ExcelScript.Worksheet,\n  titleAddress: string,\n  subtitleAddress: string\n) {\n  const title = sheet.getRange(titleAddress);\n\n  title.getFormat().getFill().setColor(\"#17365D\");\n  title.getFormat().getFont().setColor(\"#FFFFFF\");\n  title.getFormat().getFont().setBold(true);\n  title.getFormat().getFont().setSize(18);\n  title.getFormat().setRowHeight(30);\n\n  const subtitle = sheet.getRange(subtitleAddress);\n\n  subtitle.getFormat().getFont().setColor(\"#666666\");\n  subtitle.getFormat().getFont().setItalic(true);\n  subtitle.getFormat().getFont().setSize(10);\n}\n\nfunction applySectionHeader(\n  range: ExcelScript.Range\n) {\n  range.getFormat().getFill().setColor(\"#4472C4\");\n  range.getFormat().getFont().setColor(\"#FFFFFF\");\n  range.getFormat().getFont().setBold(true);\n}\n\nfunction capColumnWidth(\n  sheet: ExcelScript.Worksheet,\n  zeroBasedColumn: number,\n  maximumWidth: number\n) {\n  const column = sheet\n    .getRangeByIndexes(\n      0,\n      zeroBasedColumn,\n      1,\n      1\n    )\n    .getEntireColumn();\n\n  if (\n    column.getFormat().getColumnWidth() >\n    maximumWidth\n  ) {\n    column.getFormat().setColumnWidth(\n      maximumWidth\n    );\n  }\n}\n\nfunction makeIssue(\n  severity: Severity,\n  column: string,\n  issueType: string,\n  description: string,\n  affected: number,\n  percent: number,\n  recommendation: string\n): Issue {\n  return {\n    severity,\n    column,\n    issueType,\n    description,\n    affected,\n    percent: Number.isFinite(percent)\n      ? percent\n      : 0,\n    recommendation\n  };\n}\n\nfunction safeStringValue(\n  values: string[][],\n  row: number,\n  column: number\n): string {\n  return values[row] &&\n    values[row][column] !== undefined\n    ? values[row][column]\n    : \"\";\n}\n\nfunction safeTypeValue(\n  values: ExcelScript.RangeValueType[][],\n  row: number,\n  column: number\n): ExcelScript.RangeValueType {\n  return values[row] &&\n    values[row][column] !== undefined\n    ? values[row][column]\n    : ExcelScript.RangeValueType.empty;\n}\n\nfunction safeDivide(\n  numerator: number,\n  denominator: number\n): number {\n  return denominator > 0\n    ? numerator / denominator\n    : 0;\n}\n\nfunction percentile(\n  sorted: number[],\n  percent: number\n): number {\n  if (sorted.length === 0) {\n    return 0;\n  }\n\n  const position =\n    (sorted.length - 1) * percent;\n\n  const lower = Math.floor(position);\n  const upper = Math.ceil(position);\n\n  if (lower === upper) {\n    return sorted[lower];\n  }\n\n  return sorted[lower] +\n    (sorted[upper] - sorted[lower]) *\n    (position - lower);\n}\n\nfunction roundTo(\n  value: number,\n  decimals: number\n): number {\n  const factor = Math.pow(10, decimals);\n\n  return Math.round(value * factor) / factor;\n}\n\nfunction formatDate(date: Date): string {\n  return date\n    .toISOString()\n    .replace(\"T\", \" \")\n    .replace(\".000Z\", \" UTC\");\n}\n\nfunction formatPercentText(\n  value: number\n): string {\n  return `${roundTo(\n    value * 100,\n    1\n  ).toFixed(1)}%`;\n}\n\nfunction formatInteger(\n  value: number\n): string {\n  return Math.round(value)\n    .toLocaleString(\"en-US\");\n}\n\nfunction severityRank(\n  severity: Severity\n): number {\n  if (severity === \"Concern\") {\n    return 3;\n  }\n\n  if (severity === \"Review\") {\n    return 2;\n  }\n\n  return 1;\n}\n\nfunction uniqueStrings(\n  values: string[]\n): string[] {\n  return Array.from(new Set<string>(values));\n}","description":"This script will provide a basic profile of your small dataset.","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}